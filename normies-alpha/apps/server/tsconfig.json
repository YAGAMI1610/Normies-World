{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmitOnError": false,
    "baseUrl": ".",
    "paths": {
      "@normies-alpha/shared-types": ["../../packages/shared-types/src"],
      "@normies-alpha/contracts": ["../../packages/contracts/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
