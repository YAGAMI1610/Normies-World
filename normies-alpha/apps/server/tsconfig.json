{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@normies-alpha/shared-types": ["../../packages/shared-types/src"],
      "@normies-alpha/contracts": ["../../packages/contracts/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
