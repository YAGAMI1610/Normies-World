{
  "name": "@normies-alpha/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:indexer": "tsx watch src/indexer/index.ts",
    "build": "esbuild src/app.ts --bundle --platform=node --outfile=dist/app.js --external:@prisma/client",
    "start": "node dist/app.js",
    "start:indexer": "node dist/indexer/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@normies-alpha/contracts": "*",
    "@normies-alpha/shared-types": "*",
    "@prisma/client": "^5.18.0",
    "axios": "^1.7.4",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "openai": "^4.56.0",
    "siwe": "^2.3.2",
    "socket.io": "^4.7.5",
    "viem": "^2.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.15",
    "esbuild": "^0.28.1",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
